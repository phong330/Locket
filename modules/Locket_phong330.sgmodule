revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/phong330/Locket/main/js/Locket_DuyVinh09.js, requires-body=true, max-size=-1, timeout=60

